{
  // Process/network settings. server.workers is fixed to 1 internally for GPU safety.
  "server": {
    "host": "0.0.0.0",
    "port": 8091,
    "log_level": "info",
    "model_cache_dir": "D:/Caches/translation"
  },

  "runtime": {
    "warmup_on_start": true
  },

  "translation": {
    // Switch engines: uncomment exactly one active_model line and restart.
    // Active — NLLB seq2seq (default; normalized backend identifier is "current"):
    "active_model": "nllb",
    // Opt-in — Hy-MT2 causal LM:
    // "active_model": "hymt2",

    // Shared by every translation model profile.
    "source_language": "zho_Hans",
    "target_language": "eng_Latn",
    "default_style": "sentence",
    "device": "cuda",
    "cuda_device": 0,
    "allow_cpu_fallback": false,
    "precision": "auto",
    "batch_size": 8,
    "max_input_characters": 4000,
    "max_input_tokens": 1024,
    "allow_model_download": true,
    "local_files_only": false,
    "commercial_use": false,

    "generation": {
      "max_new_tokens": 512,
      "min_new_tokens": 1,
      "target_token_multiplier": 2.5,
      "short_text_max_new_tokens": 64,
      "num_beams": 4,
      "do_sample": false,
      "no_repeat_ngram_size": null,
      "length_penalty": 1.0,
      "early_stopping": true,
      "repetition_check": true,
      "max_repeated_token_run": 3,
      "max_repeated_ngram_ratio": 0.35,
      "retry_on_degenerate_output": true,
      "retry_num_beams": 1,
      "retry_max_new_tokens": 64,
      "temperature": 1.0,
      "styles": {
        "sentence": {
          "target_token_multiplier": 2.5,
          "short_text_max_new_tokens": 64,
          "length_penalty": 1.0
        },
        "phrase": {
          "target_token_multiplier": 1.5,
          "short_text_max_new_tokens": 32,
          "length_penalty": 0.8,
          "max_expansion_ratio": 3.0,
          "scaffolding_policy": "warn"
        }
      }
    },

    // Model-specific identity only. Do not repeat shared settings here.
    "models": {
      "nllb": {
        "backend": "current",
        "model_name": "facebook/nllb-200-distilled-600M",
        "model_family": "nllb",
        "model_revision": "main"
      },
      "hymt2": {
        "backend": "hymt2",
        "model_name": "tencent/Hy-MT2-1.8B-FP8",
        "model_family": "hymt2",
        "model_revision": "main"
      }
    }
  },

  "structured": {
    "enabled": true,
    "max_chapter_characters": 100000,
    "max_segment_tokens": 450,
    "max_target_tokens": 400,
    "context_window_tokens": 0,
    "preserve_patterns": [],
    "translatable_attributes": [],
    "excluded_tags": ["script", "style", "code", "pre"],
    "excluded_classes": ["notranslate"],
    "segment_warning_seconds": 60.0,
    "max_total_seconds": 600.0,
    "max_retries_per_segment": 1,
    "batch_size": 4,
    "concurrency": 1
  },

  "quality": {
    "unknown_token_policy": "warn"
  }
}
